# swaylock 配置
# 从 i3lock 迁移

ignore-empty-password
indicator-caps-lock

# 颜色
color=000000bf
inside-color=00000000
inside-clear-color=ffffff22
inside-ver-color=00897bE6
inside-wrong-color=880000bb

ring-color=00897bE6
ring-clear-color=ffffff22
ring-ver-color=00564dE6
ring-wrong-color=880000bb

line-color=00000000
separator-color=00897bE6

text-color=00897bE6
text-clear-color=00897bE6
text-ver-color=00897bE6
text-wrong-color=880000bb

key-hl-color=ffffff88
bs-hl-color=880000bb

# 显示时钟
clock
timestr=%H:%M:%S
datestr=%A, %Y-%m-%d

# 锁定所有输出
daemonize
