# =================================================
# Research toolchain environment (sunhh)
# =================================================

# ---- Base dirs --------------------------------------------------------------
CLIKE_DIR="$HOME/clike"
TFEL_DIR="$HOME/opt/tfel"

# ---- Helper: add to PATH if not exists --------------------------------------
_path_append() {
    case ":$PATH:" in
        *":$1:"*) ;;  # already exists
        *) export PATH="$PATH:$1" ;;
    esac
}

_ldpath_append() {
    case ":$LD_LIBRARY_PATH:" in
        *":$1:"*) ;;
        *) export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$1" ;;
    esac
}

_cpath_append() {
    case ":$C_INCLUDE_PATH:" in
        *":$1:"*) ;;
        *) export C_INCLUDE_PATH="${C_INCLUDE_PATH:+$C_INCLUDE_PATH:}$1" ;;
    esac
}

# ---- PATH: executables ------------------------------------------------------
_path_append "$HOME/.npm-global/bin"
_path_append "$HOME/bin"
_path_append "$TFEL_DIR/bin"

# ---- LD_LIBRARY_PATH: shared libraries --------------------------------------
_ldpath_append "$CLIKE_DIR/lib"
_ldpath_append "$TFEL_DIR/lib"

# ---- C/C++ include search path ---------------------------------------------
_cpath_append "$CLIKE_DIR/include"

# ---- Julia settings ---------------------------------------------------------
export JULIA_PKG_SERVER="https://mirror.nju.edu.cn/julia"

# ---- Cleanup ----------------------------------------------------------------
unset -f _path_append _ldpath_append _cpath_append
