# -*- mode: conf -*-

set $mod Mod4

# Font for window titles
font pango:monospace 12

# disable Xwayland entirely
# xwayland disable

# 壁纸 (Wayland 原生，替代 feh)
output HDMI-A-1 bg $HOME/config/conf.d/wallpaper1 fill
output DP-1 bg $HOME/config/conf.d/wallpaper2 fill

# 输出配置 (替代 xrandr)
# 查看: swaymsg -t get_outputs
output HDMI-A-1 pos 0 0 res 1920x1080
output DP-1 pos 1920 0 res 1920x1080

# 键盘配置
input type:keyboard {
    xkb_layout us
}

# 环境变量 (Wayland 版本)
exec --no-startup-id systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec --no-startup-id dbus-update-activation-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK

########## 自动启动 ###########
exec --no-startup-id fcitx5 -d
exec --no-startup-id nutstore
exec --no-startup-id wayvnc -o HDMI-A-1

exec --no-startup-id swayidle -w \
    timeout 300 '$HOME/config/conf.d/swaylock' \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f'

########## 音量控制 ###########
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

########## 亮度控制 ###########
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl s 20%-
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl s +20%

########## 基本操作 ###########

# 鼠标拖动浮动窗口
floating_modifier $mod normal

# 终端
set $term alacritty
bindsym $mod+Return exec --no-startup-id $term

# 关闭窗口
bindsym $mod+Shift+q kill

# 启动器 (rofi)
bindsym $mod+d exec --no-startup-id rofi -show drun
bindsym $mod+Shift+d exec --no-startup-id rofi -show run
bindsym $mod+Tab exec --no-startup-id rofi -show window
# 焦点移动
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# 移动窗口
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# 分割
bindsym $mod+b splith
bindsym $mod+v splitv

# 全屏
bindsym $mod+f fullscreen toggle

# 布局
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# 浮动/平铺切换
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# 父容器
bindsym $mod+a focus parent

# 隐藏窗口 (scratchpad)
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# 快捷启动
bindsym $mod+c exec --no-startup-id firefox
set $filemanager "pcmanfm"
bindsym $mod+t exec --no-startup-id $filemanager

# 截图 (grimshot)
set $screenshot exec --no-startup-id grimshot save
bindsym --release Print $screenshot output ~/Screenshot-$(date +%Y%m%d_%H%M%S).png
bindsym --release Shift+Print $screenshot area ~/Screenshot-$(date +%Y%m%d_%H%M%S).png
bindsym --release $mod+Print $screenshot window ~/Screenshot-$(date +%Y%m%d_%H%M%S).png
# 备用快捷键 (无 Print 键时)
bindsym $mod+p $screenshot output ~/Screenshot-$(date +%Y%m%d_%H%M%S).png
bindsym $mod+Shift+p $screenshot area ~/Screenshot-$(date +%Y%m%d_%H%M%S).png
bindsym $mod+Ctrl+p $screenshot window ~/Screenshot-$(date +%Y%m%d_%H%M%S).png

########## 工作区 ###########
set $ws1  1:  
set $ws2  2:  
set $ws3  3:  
set $ws4  4:  
set $ws5  5:  
set $ws6  6:  
set $ws7  7:  
set $ws8  8:  
set $ws9  9:  
set $ws10 10:  

# 切换工作区
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# 移动窗口到工作区
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# 重载配置
bindsym $mod+Shift+c reload

########## 调整大小 ###########
mode "resize" {
    bindsym h resize shrink width 10 px
    bindsym j resize shrink height 10 px
    bindsym k resize grow height 10 px
    bindsym l resize grow width 10 px

    bindsym Left resize shrink width 10 px
    bindsym Down resize shrink height 10 px
    bindsym Up resize grow height 10 px
    bindsym Right resize grow width 10 px

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

########## 窗口边框 ###########
# 默认边框
default_border none
default_floating_border none

########## 颜色 ###########
# class                 border  background  text    indicator  child_border
client.focused          #333333 #333333     #FFFFFF #333333    #333333
client.focused_inactive #999999 #999999     #FFFFFF #3399FF    #3399FF
client.unfocused        #999999 #999999     #FFFFFF #3399FF    #3399FF
client.urgent           #990000 #990000     #FFFFFF #990000    #990000
client.placeholder      #000000 #000000     #FFFFFF #000000    #000000
client.background       #FFFFFF

########## 状态栏 ###########
# Mod+Shift+b 切换 waybar 显示/隐藏
bindsym $mod+Shift+b exec pkill -x waybar || waybar &

# 启动时自动运行 waybar
exec --no-startup-id waybar

# gaps
gaps inner 0
gaps outer 0

########## 电源管理 ###########
set $mode_system  lock(L) logout(O) reboot(R) shutdown(S) exit(Esc)
bindsym $mod+Shift+a mode "$mode_system"
mode "$mode_system" {
    bindsym l exec --no-startup-id $HOME/config/conf.d/swaylock, mode "default",
    bindsym o exec --no-startup-id swaymsg exit, mode "default"
    bindsym r exec --no-startup-id systemctl reboot, mode "default"
    bindsym s exec --no-startup-id systemctl poweroff, mode "default"
    bindsym Escape mode "default"
}
