# ~/.zshrc
# =================================================

# ---------- 共享 aliases（所有 shell 都加载）----------
[[ -f "$HOME/config/conf.d/shrc_common" ]] && source "$HOME/config/conf.d/shrc_common"

# 以下只在交互式 shell 加载
[[ -o interactive ]] || return

# ---------- 基本选项 ----------
setopt auto_cd
setopt interactive_comments
setopt hist_ignore_dups
setopt share_history

# ---------- 补全 ----------
autoload -Uz compinit
compinit

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# ---------- Prompt（简单、稳定、可读） ----------
# 绿色用户名 + 蓝色路径 + $
PROMPT='%K{green}%n%k %F{39}%~%f %F{70}$%f '


