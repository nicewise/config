{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 4,
    "modules-left": [
        "sway/workspaces"
    ],
    "modules-center": [],
    "modules-right": [
        "network",
        "cpu",
        "memory",
        "disk",
        "pulseaudio",
        "clock#date",
        "clock#time",
        "tray"
    ],
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}"
    },
    "network": {
        "format-wifi": " {ipaddr}  {bandwidthUpBits}  {bandwidthDownBits}",
        "format-ethernet": " {ipaddr}  {bandwidthUpBits}  {bandwidthDownBits}",
        "format-disconnected": "",
        "tooltip-format": "{ifname}: {ipaddr}",
        "interval": 2
    },
    "cpu": {
        "format": " {usage}%",
        "tooltip": false,
        "interval": 2
    },
    "memory": {
        "format": " {used:0.1f}G {total:0.1f}G",
        "interval": 2
    },
    "disk": {
        "path": "/",
        "format": " {percentage_used}%",
        "interval": 10
    },
    "pulseaudio": {
        "scroll-step": 5,
        "format": " {volume}%",
        "format-muted": " {volume}%",
        "on-click": "pavucontrol"
    },
    "clock#date": {
        "format": " {:%Y-%m-%d %a}",
        "interval": 60
    },
    "clock#time": {
        "format": " {:%H:%M}",
        "interval": 1
    },
    "tray": {
        "icon-size": 16,
        "spacing": 4
    }
}