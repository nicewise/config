// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "fixed-center": false,
    "spacing": 4,
    "reload_style_on_change": true,
    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center": ["sway/window"],
    "modules-right": [
        "network",
        "cpu",
        "memory",
        "disk",
        "pulseaudio",
        "clock#date",
        "clock#time",
        "tray"
    ],
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}"
    },
    "sway/mode": {
        "format": " {}"
    },
    "sway/window": {
        "format": "{shell}|{title}",
        "max-length": 50
    },
    "network": {
        "format-wifi": " {ipaddr} {bandwidthUpBits} {bandwidthDownBits}",
        "format-ethernet": " {ipaddr} {bandwidthUpBits} {bandwidthDownBits}",
        "format-disconnected": "",
        "tooltip-format": "{ifname}: {ipaddr}",
        "interval": 2
    },
    "cpu": {
        "format": " {usage}%",
        "tooltip": false,
        "interval": 2
    },
    "memory": {
        "format": " {used:0.1f}G/{total:0.1f}G",
        "interval": 2
    },
    "disk": {
        "path": "/",
        "format": " {percentage_used}%",
        "interval": 10
    },
    "pulseaudio": {
        "scroll-step": 5,
        "format": "{icon} {volume}%",
        "format-muted": " {volume}%",
        "format-icons": {
          "default": [
            "",
	    "",
            ""
          ]
        },
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },
    "clock#date": {
        "format": " {:%Y-%m-%d %a}",
	"tooltip": false,
        "interval": 60
    },
    "clock#time": {
        "format": " {:%H:%M}",
	"tooltip": false,
        "interval": 1
    },
    "tray": {
        "icon-size": 16,
        "spacing": 4
    }
}